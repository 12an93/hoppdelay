[Unit]
Description=Hoppdelay
After=multi-user.target

[Service]
# Optional: choose cameras (default: every USB camera with MJPEG up to 1080p30, at most two).
# List them with: ls /dev/v4l/by-id/
#Environment=HOPPDELAY_CAMS=/dev/v4l/by-id/usb-...-video-index0,/dev/v4l/by-id/usb-...-video-index0
# Optional: AI feedback from any OpenAI-compatible endpoint, e.g. Ollama
#Environment=HOPPDELAY_LLM_URL=http://192.168.1.10:11434/v1/chat/completions
#Environment=HOPPDELAY_LLM_MODEL=qwen3:8b
# Jabra PanaCast 20 only: widest view, centered, 50 Hz anti-flicker. Harmless if the camera is missing.
ExecStartPre=-/bin/sh -c 'for c in /dev/v4l/by-id/*PanaCast_20*-video-index0; do v4l2-ctl -d "$c" -c zoom_absolute=100,pan_absolute=0,tilt_absolute=0,power_line_frequency=1; done'
ExecStart=/usr/local/bin/hoppdelay.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
